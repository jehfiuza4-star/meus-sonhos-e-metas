rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /data/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /reading/{year} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
